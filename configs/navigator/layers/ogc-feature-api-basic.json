{
  "configMeta": {
    "description": "OGC API Features examples using default vector styling with WMS style fetching disabled. Includes large lakes, weather and climate stations, and current and archived flood extents."
  },
  "map": {
    "viewSettings": {
      "projection": 3857
    },
    "basemapOptions": {
      "basemapId": "transport",
      "shaded": false,
      "labeled": true
    },
    "listOfGeoviewLayerConfig": [
      {
        "geoviewLayerId": "ogcFeatureLYR1",
        "geoviewLayerName": "Large Lakes",
        "metadataAccessPath": "https://b6ryuvakk5.execute-api.us-east-1.amazonaws.com/dev",
        "geoviewLayerType": "ogcFeature",
        "fetchStylesOnWMS": false,
        "listOfLayerEntryConfig": [
          {
            "layerId": "lakes"
          }
        ]
      },
      {
        "geoviewLayerId": "weather-clim-group",
        "geoviewLayerName": "Weather Climate Group",
        "metadataAccessPath": "https://api.weather.gc.ca",
        "geoviewLayerType": "ogcFeature",
        "fetchStylesOnWMS": false,
        "listOfLayerEntryConfig": [
          {
            "layerId": "ahccd-stations",
            "wmsUrl": "https://geo.weather.gc.ca/geomet-climate",
            "wmsLayerId": "AHCCD.STATIONS"
          }
        ]
      },
      {
        "geoviewLayerId": "flood-eodms-sgdot",
        "geoviewLayerName": "Flood",
        "metadataAccessPath": "https://eodms-sgdot.nrcan-rncan.gc.ca/maps/egs/wfs3",
        "geoviewLayerType": "ogcFeature",
        "fetchStylesOnWMS": false,
        "listOfLayerEntryConfig": [
          {
            "layerId": "EGS_Flood_Extent_Current_en"
          },
          {
            "layerId": "EGS_Flood_Extent_Archive_en"
          }
        ]
      }
    ]
  },
  "components": [
    "overview-map",
    "north-arrow"
  ],
  "overviewMap": {
    "hideOnZoom": 7
  },
  "navBar": [
    "zoom",
    "rotation",
    "fullscreen",
    "home",
    "location",
    "measurement",
    "basemap-select",
    "projection"
  ],
  "appBar": {
    "tabs": {
      "core": [
        "geolocator",
        "legend",
        "details",
        "export"
      ]
    }
  },
  "footerBar": {
    "tabs": {
      "core": [
        "layers",
        "data-table"
      ]
    }
  },
  "corePackages": [],
  "theme": "geo.ca",
  "serviceUrls": {
    "proxyUrl": "https://proxy.app-dev.geo.ca"
  }
}

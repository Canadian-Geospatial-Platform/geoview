{
  "stacUrl": "https://datacube.services.geo.ca/stac/api",
  "browseEnabled": true,
  "defaultMode": "browse",
  "filters": {
    "collections": true,
    "temporal": true,
    "spatial": true,
    "keyword": true,
    "sort": true
  },
  "defaults": {
    "useMapExtent": false,
    "containedInExtent": false,
    "limit": 20
  },
  "footprintStyles": {
    "collection": {
      "color": "#1976d2",
      "fillOpacity": 0.2
    },
    "search": {
      "color": "#FF8C00",
      "fillOpacity": 0.25
    }
  },
  "displayPreview": true,
  "isOpen": false,
  "version": "1.0"
}

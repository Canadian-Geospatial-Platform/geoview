      {
        "geoviewLayerId": "weather-clim-group",
        "geoviewLayerName": "Weather Climate Group",
        "metadataAccessPath": "https://api.weather.gc.ca",
        "geoviewLayerType": "ogcFeature",
        "listOfLayerEntryConfig": [
          {
            "layerId": "ahccd-stations",
            "wmsUrl": "https://geo.weather.gc.ca/geomet-climate",
            "wmsLayerId": "AHCCD.STATIONS"
          }
        ]
      },
      {
        "geoviewLayerId": "flood-eodms-sgdot",
        "geoviewLayerName": "Flood EODMS-SGDOT (style not working, incomplete GetStyles information)",

{
  "configMeta": {
    "description": "Configuration for WMS CDT Landcover layers. Landcover 2010-2020 Group (XML) reads the capabilities from the landcover_groupe.xml file and adds the landcover_groupe group directly, exploding its sub-layers (2010, 2015, 2020) on-the-fly. Landcover 2010-2020 Distinct (XML) reads the same file but explicitly lists the 3 sub-layers, with each initially hidden."
  },
  "map": {
    "viewSettings": {
      "projection": 3857
    },
    "basemapOptions": {
      "basemapId": "transport",
      "shaded": false,
      "labeled": true
    },
    "listOfGeoviewLayerConfig": [
      {
        "geoviewLayerId": "landcover-xml-group",
        "geoviewLayerName": "Landcover 2010-2020 Group (XML)",
        "metadataAccessPath": "https://qgis-stage.cdtk.geogc.ca/ows/nrcan/landcover_vrt_en",
        "geoviewLayerType": "ogcWms",
        "listOfLayerEntryConfig": [
          {
            "layerId": "landcover_groupe"
          }
        ]
      },
      {
        "geoviewLayerId": "landcover-xml-distinct",
        "geoviewLayerName": "Landcover 2010-2020 Distinct (XML)",
        "metadataAccessPath": "https://qgis-stage.cdtk.geogc.ca/ows/nrcan/landcover_vrt_en",
        "geoviewLayerType": "ogcWms",
        "listOfLayerEntryConfig": [
          {
            "layerId": "landcover_2010_19classes",
            "initialSettings": {
              "states": {
                "visible": false
              }
            }
          },
          {
            "layerId": "landcover_2015_19classes",
            "initialSettings": {
              "states": {
                "visible": false
              }
            }
          },
          {
            "layerId": "landcover_2020_19classes",
            "initialSettings": {
              "states": {
                "visible": false
              }
            }
          }
        ]
      }
    ]
  },
  "components": [

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoview.ca/filter-panel-schema.json",
  "title": "Filter Panel Configuration Schema",
  "description": "Schema for configuring the GeoView Filter Panel plugin",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "isOpen": {
      "type": "boolean",
      "description": "Whether the panel is open by default",
      "default": false
    },
    "version": {
      "type": "string",
      "description": "Configuration version",
      "default": "1.0"
    },
    "title": {
      "type": "string",
      "description": "Panel title",
      "default": "Filter Layers"
    },
    "layers": {
      "type": "array",
      "description": "Array of layer configurations for filtering",
      "items": {
        "type": "object",
        "required": [
          "layerPath"
        ],
        "properties": {
          "layerPath": {
            "type": "string",
            "description": "Unique identifier for the layer (layer path)"
          },
          "filterName": {
            "type": "string",
            "description": "Display name for the layer"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether filtering is enabled for this layer",
            "default": true
          },
          "collapsible": {
            "type": "boolean",
            "description": "Allow collapsing/expanding this layer section",
            "default": true
          },
          "defaultCollapsed": {
            "type": "boolean",
            "description": "Default collapsed state for this layer section. Ignored if collapsible is false (forced to false/open).",
            "default": false
          },
          "attributes": {
            "type": "array",
            "description": "Array of filterable attributes",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/definitions/TypeSelectFilterAttribute"
                },
                {
                  "$ref": "#/definitions/TypeMultiselectFilterAttribute"
                },
                {
                  "$ref": "#/definitions/TypeRangeFilterAttribute"
                },
                {
                  "$ref": "#/definitions/TypeDateFilterAttribute"
                }
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "TypeBaseFilterAttribute": {
      "type": "object",
      "description": "Base properties shared by all filter attributes",
      "properties": {
        "fieldName": {
          "type": "string",
          "description": "Field name in the layer"
        },
        "displayLabel": {
          "type": "string",
          "description": "Display label for the filter"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this attribute filter is enabled",
          "default": true
        }
      },
      "required": [
        "fieldName",
        "displayLabel"
      ]
    },
    "TypeSelectFilterAttribute": {
      "allOf": [
        {
          "$ref": "#/definitions/TypeBaseFilterAttribute"
        },
        {
          "type": "object",
          "properties": {
            "filterType": {
              "const": "select",
              "description": "Single-value dropdown selection"
            },
            "defaultValues": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "description": "Default single value"
            },
            "domain": {
              "$ref": "#/definitions/TypeDomainArray"
            },
            "filterMissingDomainValues": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "filterType"
          ]
        }
      ]
    },
    "TypeMultiselectFilterAttribute": {
      "allOf": [
        {
          "$ref": "#/definitions/TypeBaseFilterAttribute"
        },
        {
          "type": "object",
          "properties": {
            "filterType": {
              "const": "multiselect",
              "description": "Multiple-value checkbox list"
            },
            "defaultValues": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              ],
              "description": "Default array of selected values"
            },
            "domain": {
              "$ref": "#/definitions/TypeDomainArray"
            },
            "filterMissingDomainValues": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "filterType"
          ]
        }
      ]
    },
    "TypeRangeFilterAttribute": {
      "allOf": [
        {
          "$ref": "#/definitions/TypeBaseFilterAttribute"
        },
        {
          "type": "object",
          "properties": {
            "filterType": {
              "const": "range",
              "description": "Numeric min/max range"
            },
            "rangeStep": {
              "type": "number",
              "description": "Step interval for range filter keyboard navigation",
              "default": 1
            },
            "defaultValues": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "min": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "max": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "description": "Default range object with min/max"
            }
          },
          "required": [
            "filterType"
          ]
        }
      ]
    },
    "TypeDateFilterAttribute": {
      "allOf": [
        {
          "$ref": "#/definitions/TypeBaseFilterAttribute"
        },
        {
          "type": "object",
          "properties": {
            "filterType": {
              "const": "date",
              "description": "Date range picker"
            },
            "dateStep": {
              "type": "string",
              "description": "Step interval for date filter keyboard navigation",
              "enum": [
                "second",
                "minute",
                "hour",
                "day",
                "week",
                "month",
                "year"
              ],
              "default": "day"
            },
            "defaultValues": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "end": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ],
              "description": "Default date range with start/end"
            }
          },
          "required": [
            "filterType"
          ]
        }
      ]
    },
    "TypeDomainArray": {
      "type": "array",
      "description": "Domain mapping for value labels",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "properties": {
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
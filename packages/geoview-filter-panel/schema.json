{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geoview.ca/filter-panel-schema.json",
  "title": "Filter Panel Configuration Schema",
  "description": "Schema for configuring the GeoView Filter Panel plugin",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Whether the filter panel is enabled",
      "default": true
    },
    "isOpen": {
      "type": "boolean",
      "description": "Whether the panel is open by default",
      "default": false
    },
    "version": {
      "type": "string",
      "description": "Configuration version",
      "default": "1.0"
    },
    "layers": {
      "type": "array",
      "description": "Array of layer configurations for filtering",
      "items": {
        "type": "object",
        "required": [
          "layerPath"
        ],
        "properties": {
          "layerPath": {
            "type": "string",
            "description": "Unique identifier for the layer (layer path)"
          },
          "layerName": {
            "type": "string",
            "description": "Display name for the layer"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether filtering is enabled for this layer",
            "default": true
          },
          "attributes": {
            "type": "array",
            "description": "Array of filterable attributes",
            "items": {
              "type": "object",
              "required": [
                "fieldName",
                "displayLabel",
                "filterType"
              ],
              "properties": {
                "fieldName": {
                  "type": "string",
                  "description": "Field name in the layer"
                },
                "displayLabel": {
                  "type": "string",
                  "description": "Display label for the filter"
                },
                "filterType": {
                  "type": "string",
                  "enum": [
                    "select",
                    "multiselect",
                    "range",
                    "date"
                  ],
                  "description": "Type of filter control"
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether this attribute filter is enabled",
                  "default": true
                },
                "defaultValues": {
                  "description": "Default filter values",
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "array"
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "domain": {
                  "type": "array",
                  "description": "Domain mapping for value labels. Maps raw values to display labels. Only applies to 'select' and 'multiselect' filter types.",
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "label"
                    ],
                    "properties": {
                      "value": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "description": "The raw value from the layer"
                      },
                      "label": {
                        "type": "string",
                        "description": "The display label for this value"
                      }
                    }
                  }
                },
                "filterMissingDomainValues": {
                  "type": "boolean",
                  "description": "If true, values not in the domain are filtered out. If false, they are shown with their raw value. Only applies when domain is defined and filterType is 'select' or 'multiselect'.",
                  "default": false
                }
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "description": "Global filter panel settings",
      "properties": {
        "title": {
          "type": "string",
          "description": "Panel title",
          "default": "Filter Layers"
        },
        "collapsible": {
          "type": "boolean",
          "description": "Allow collapsing/expanding layer sections",
          "default": true
        },
        "defaultCollapsed": {
          "type": "boolean",
          "description": "Default collapsed state for layer sections",
          "default": false
        },
        "showResetButton": {
          "type": "boolean",
          "description": "Show reset button",
          "default": true
        },
        "autoApply": {
          "type": "boolean",
          "description": "Auto-apply filters on change",
          "default": true
        }
      }
    }
  }
}
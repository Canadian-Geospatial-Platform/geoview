{
  "configMeta": {
    "description": "Configuration for WMS CDT Landcover layers. The Landcover 2010-2020 Group (XML) entry loads the landcover_groupe group from the service capabilities and expands its advertised sub-layers during layer creation. This in turn creates a group-time-dimension to be used by the Time Slider component. The Landcover (no group-time-dimension) entry explicitly loads the 2010 and 2020 sub-layers as separate layers, which doesn't trigger the group-time-dimension."
  },
  "map": {
    "viewSettings": {
      "projection": 3857
    },
    "basemapOptions": {
      "basemapId": "transport",
      "shaded": false,
      "labeled": true
    },
    "listOfGeoviewLayerConfig": [
      {
        "geoviewLayerId": "landcover-xml-group",
        "geoviewLayerName": "Landcover 2010-2020 Group (XML)",
        "metadataAccessPath": "https://qgis-stage.cdtk.geogc.ca/ows/nrcan/landcover_vrt_en",
        "geoviewLayerType": "ogcWms",
        "listOfLayerEntryConfig": [
          {
            "layerId": "landcover_groupe"
          }
        ]
      },
      {
        "geoviewLayerId": "landcover-xml-distinct",
        "geoviewLayerName": "Landcover (no group-time-dimension)",
        "metadataAccessPath": "https://qgis-stage.cdtk.geogc.ca/ows/nrcan/landcover_vrt_en",
        "geoviewLayerType": "ogcWms",
        "listOfLayerEntryConfig": [
          {
            "layerId": "landcover_2010_19classes"
          },
          {
            "layerId": "landcover_2020_19classes"
          }
        ]
      }
    ]
  },
  "components": [
    "overview-map",
    "north-arrow"
  ],
  "overviewMap": {
    "hideOnZoom": 7
  },
  "navBar": [
    "zoom",
    "rotation",
    "fullscreen",
    "home",
    "location",
    "measurement",
    "basemap-select",
    "projection"
  ],
  "appBar": {
    "tabs": {
      "core": [
        "geolocator",
        "legend",
        "details",
        "export"
      ]
    }
  },
  "footerBar": {
    "tabs": {
      "core": [
        "layers",
        "data-table",
        "time-slider"
      ]
    }
  },
  "corePackages": [],
  "theme": "geo.ca",
  "serviceUrls": {
    "proxyUrl": "https://proxy.app-dev.geo.ca"
  }
}
